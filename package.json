{
    "name": "plugin-groups",
    "version": "2.1.0",
    "description": "Organize plugins by groups and filter types",
    "repository": {
        "type": "git",
        "url": "https://github.com/DavidCramer/plugin-groups"
    },
    "author": "DavidCramer",
    "license": "GPLv2+",
    "bugs": {
        "url": "https://github.com/DavidCramer/plugin-groups/issues"
    },
    "engines": {
        "node": ">=20.19.0",
        "npm": ">=10.2.3"
    },
    "scripts": {
        "build": "npm run build:assets && npm run build:pot",
        "build:assets": "vite build",
        "build:pot": "composer make-pot",
        "dev": "vite",
        "lint:js": "eslint . --ext .js,.jsx,.ts,.tsx",
        "lint:css": "stylelint '**/*.{css,scss}'",
        "format": "prettier --write '**/*.{js,jsx,ts,tsx,css,scss,md}'",
        "pack": "grunt",
        "postinstall": "composer install"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.2.2",
        "@tailwindcss/vite": "^4.2.2",
        "@typescript-eslint/eslint-plugin": "^8.15.0",
        "@typescript-eslint/parser": "^8.15.0",
        "@vitejs/plugin-react": "^6.0.2",
        "@wordpress/i18n": "^6.23.0",
        "grunt": "^1.4.1",
        "grunt-cli": "^1.4.3",
        "grunt-contrib-clean": "^2.0.0",
        "grunt-contrib-compress": "^2.0.0",
        "grunt-contrib-copy": "^1.0.0",
        "mini-css-extract-plugin": "^2.10.2",
        "sortablejs": "^1.15.0",
        "tailwindcss": "^4.1.17",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.58.2",
        "vite": "^8.0.16",
        "react": "^19.2.7",
        "react-dom": "^19.2.7"
    }
}
